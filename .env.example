# Required for production Compose only. Replace with your external database URI.
# Do not copy actual credentials into this template or commit real .env files.
MONGODB_URI=mongodb://database-host.example:27017/techyfellow

# Production requires exact HTTPS frontend origins, including the same-origin Nginx site.
AUTH_ALLOWED_ORIGINS=https://frontend-host.example
AUTH_SESSION_TTL_SECONDS=28800
# Empty by default; configure only verified reverse proxy literal IPs if per-client limits are needed.
AUTH_TRUSTED_PROXY_IPS=

# Public frontend build-time API base; default same-origin Nginx routing. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional backend-only R2 settings. Empty settings disable uploads with an explicit unavailable response.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com; use the bucket's jurisdiction-specific endpoint if applicable.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# One exact approved public HTTPS origin, e.g. https://media.example.invalid; no path/query.
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_DIMENSION=8192
MEDIA_MAX_PIXELS=40000000

# Public build-time delivery hostname only, e.g. media.example.invalid. Must match MEDIA_PUBLIC_BASE_URL's hostname.
# Empty disables remote previews. Never include credentials, scheme, port, path or wildcards.
NEXT_PUBLIC_MEDIA_HOST=

# Server-only published content endpoint. No credentials/query; never exposed in browser assets.
# Host-run frontend default is http://127.0.0.1:4000/api/v1; Compose uses http://backend:4000/api/v1.
CONTENT_API_BASE_URL=http://backend:4000/api/v1

# Optional server-only verified canonical origin. HTTPS origin only; leave empty until confirmed.
PUBLIC_SITE_URL=

# Backend/worker only. Disabled by default; no live delivery is enabled by local startup.
EMAIL_ENABLED=false
RESEND_API_KEY=
# Verified plain sender address, internal recipient(s), and exact HTTPS /admin URL when delivery is authorized.
EMAIL_FROM=
LEAD_NOTIFICATION_TO=
ADMIN_BASE_URL=

# Optional backend/worker-only account verification encryption key, 64 lowercase hex characters.
# Supply securely; leave empty locally. Live email remains disabled.
ACCOUNT_VERIFICATION_KEY=
