# Public build-time setting, not a secret. Defaults to same-origin Nginx /api/v1.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# For independent localhost development only, set http://localhost:4000/api/v1 instead.
# Production absolute URLs require HTTPS and frontend/API must share a site for SameSite=Lax cookies.

# Public build-time delivery hostname only, e.g. media.example.invalid. Must match MEDIA_PUBLIC_BASE_URL's hostname.
# Empty disables remote previews. Never include credentials, scheme, port, path or wildcards.
NEXT_PUBLIC_MEDIA_HOST=

# Server-only published content endpoint. No credentials/query; never exposed in browser assets.
# Host-run frontend default is http://127.0.0.1:4000/api/v1; Compose uses http://backend:4000/api/v1.
CONTENT_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Optional server-only verified canonical origin. HTTPS origin only; leave empty until confirmed.
PUBLIC_SITE_URL=
