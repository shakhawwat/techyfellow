# Runtime variables; export in your shell. This template is not automatically loaded.
PORT=4000
NODE_ENV=development
# Container development only: the backend resolves the Compose service hostname.
MONGODB_URI=mongodb://mongodb:27017/techyfellow?replicaSet=rs0

# Exact origins only. Includes the same-origin Nginx localhost endpoint and direct frontend dev.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Absolute lifetime in seconds; startup accepts 900–86400, default 28800.
AUTH_SESSION_TTL_SECONDS=28800
# Optional comma-separated literal IPs of verified reverse proxies; empty means trust none.
AUTH_TRUSTED_PROXY_IPS=
# Explicit bootstrap command only: supply BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD securely.
# Neither variable is used during application startup; no credentials belong in this template.

# Optional backend-only R2 settings. Empty settings disable uploads with an explicit unavailable response.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com; use the bucket's jurisdiction-specific endpoint if applicable.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# One exact approved public HTTPS origin, e.g. https://media.example.invalid; no path/query.
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_DIMENSION=8192
MEDIA_MAX_PIXELS=40000000

# Explicit auth:create-sales-manager command only: securely supply SALES_MANAGER_EMAIL
# and SALES_MANAGER_PASSWORD; these credentials are never used at startup.

# Backend/worker only. Disabled by default; no live delivery is enabled by local startup.
EMAIL_ENABLED=false
RESEND_API_KEY=
# Verified plain sender address, internal recipient(s), and exact HTTPS /admin URL when delivery is authorized.
EMAIL_FROM=
LEAD_NOTIFICATION_TO=
ADMIN_BASE_URL=

# Server-only key for account verification and domain-separated immediate scholarship-generation retries: 64 lowercase hex characters.
# Leave empty until supplied securely. Never share it with the frontend or commit a real key.
ACCOUNT_VERIFICATION_KEY=
